<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="none">

    <listeners>
        <listener class-name="com.demo.seleniumautomation.listeners.TestListener"/>
    </listeners>

    <test name="UI and API Tests">
        <packages>
            <package name="com.demo.seleniumautomation.tests.ui"/>
            <package name="com.demo.seleniumautomation.tests.api"/>
        </packages>
    </test>

</suite>